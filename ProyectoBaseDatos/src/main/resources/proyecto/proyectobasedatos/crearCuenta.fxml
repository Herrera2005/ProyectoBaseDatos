<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="proyecto.proyectobasedatos.CrearCuentaController">
   <children>
      <Label layoutX="40.0" layoutY="37.0" text="Crear Cuenta">
         <font>
            <Font name="Bauhaus 93" size="27.0" />
         </font>
      </Label>
      <Label layoutX="48.0" layoutY="86.0" text="Nombres" />
      <Label layoutX="48.0" layoutY="153.0" text="Apellidos" />
      <Label layoutX="48.0" layoutY="219.0" text="Usuario" />
      <Label layoutX="48.0" layoutY="289.0" text="Contraseña" />
      <TextField fx:id="nombresText" layoutX="48.0" layoutY="103.0" promptText="Escriba los Nombres" />
      <TextField fx:id="apellidosText" layoutX="48.0" layoutY="170.0" promptText="Escriba los Apellidos" />
      <TextField fx:id="usuarioText" layoutX="48.0" layoutY="236.0" promptText="Excriba el Usuario" />
      <TextField fx:id="contraseniaText" layoutX="48.0" layoutY="309.0" promptText="Escriba la contraseña" />
      <Button layoutX="380.0" layoutY="224.0" mnemonicParsing="false" onAction="#PaginaInicioSecion" text="Iniciar Secion" />
      <Button layoutX="380.0" layoutY="149.0" mnemonicParsing="false" onAction="#crearCuenta" text="Crear Cuenta" />
   </children>
</AnchorPane>
